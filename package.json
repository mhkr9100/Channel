{
  "name": "channel",
  "version": "0.1.0",
  "private": true,
  "description": "A WhatsApp-style app for your AI agents: chat with one, several, or a group, and approve what they pass to each other.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "tsx src/server/main.ts",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "test": "node --test --import tsx --test-concurrency=1 tests/*.test.ts",
    "test-agents": "tsx test-agents/run.ts",
    "bridge": "tsx bridge/run.ts",
    "build:web": "vite build"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
