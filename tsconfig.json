{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src",
    "tests",
    "test-agents",
    "bridge",
    "server.ts"
  ]
}
